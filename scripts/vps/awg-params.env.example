# Параметры маскировки AmneziaWG — должны совпадать на VPS и на Cudy.
# Скопируйте на VPS: cp awg-params.env.example awg-params.env
# На роутере: положите тот же файл рядом с awg-apply.sh как awg-params.env
#
# Значения ниже — пример; для своей установки можно сгенерировать другие (см. доку AmneziaWG).

AWG_JC=4
AWG_JMIN=40
AWG_JMAX=70
AWG_S1=0
AWG_S2=0
AWG_H1=1
AWG_H2=2
AWG_H3=3
AWG_H4=4
