# Пример переменных для настройки Cudy (export перед запуском скриптов).

# Публичный IP вашего VPS (без порта)
export WG_ENDPOINT=VPS_IP
export WG_PORT=443

# Адрес пира Cudy в туннеле (должен совпадать с CLIENT_IP на VPS)
export WG_ADDR=10.9.0.2/24

# Uplink Wi‑Fi (два клиента — failover 5 ГГц / 2,4 ГГц)
export WISP5_SSID=UPLINK_5
export WISP24_SSID=UPLINK_24
export WISP_KEY=your_uplink_wifi_password

# Точки доступа для телефонов (весь трафик через VPN)
export AP24_SSID=Travel-VPN-2.4G
export AP5_SSID=Travel-VPN-5G
export AP_KEY=your_ap_wifi_password

export LAN_IP=192.168.10.1
